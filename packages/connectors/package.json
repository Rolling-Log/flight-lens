{
  "name": "@flight-lens/connectors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke:domestic": "node --conditions=development --import tsx scripts/domestic-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fly-ai/flyai-cli": "1.0.16",
    "@flight-lens/contracts": "workspace:*",
    "playwright": "1.58.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
