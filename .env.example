NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

API_HOST=::
API_PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

DATABASE_URL=
DATABASE_DIRECT_URL=

OPENAI_INTENT_PARSER_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# V1 国内实时来源。FlyAI 可匿名试用，但正式 Key 更稳定；浏览器采集使用隔离会话。
FLYAI_ENABLED=true
FLYAI_API_KEY=
FLYAI_CLI_PATH=
DOMESTIC_BROWSER_CONNECTORS_ENABLED=true
BROWSER_EXECUTABLE_PATH=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge
BROWSER_HEADLESS=true
BROWSER_PROXY_SERVER=http://127.0.0.1:7890
BROWSER_NAVIGATION_TIMEOUT_MS=16000

FLIGHTAPI_API_KEY=
FLIGHTAPI_BASE_URL=https://api.flightapi.io
FLIGHTAPI_MAX_SEARCHES_PER_PROCESS=10

SKYSCANNER_API_KEY=
SKYSCANNER_BASE_URL=https://partners.api.skyscanner.net

SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_MONTHLY_CREDIT_CAP=200

DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

CONNECTOR_TIMEOUT_MS=45000
AUDIT_TIMEOUT_MS=3000
SEARCH_RATE_LIMIT_MAX=2
CONNECTOR_MAX_RETRIES=1
CONNECTOR_CACHE_TTL_MS=60000
CONNECTOR_STALE_IF_ERROR_MS=300000
